rules_version = '2';

// FamilyMap — Cloud Firestore security rules
//
// Principles
//   * Deny by default. Every collection below has an explicit allow; anything
//     not matched is rejected.
//   * A user's location (users/{uid}.lastLocation) is readable ONLY by the
//     user and by people in the same family.
//   * Only the LAST location is stored — no history.
//   * Cloud Functions use the Admin SDK and bypass these rules; they perform
//     the privileged clean-up (account deletion, purging a family once its
//     last member leaves) so the client never needs broad write access.
//
// Multi-document writes (create family, join family) are done by the client
// as a single WriteBatch. Inside a batch, `get()`/`exists()` see the state
// BEFORE the batch and `getAfter()`/`existsAfter()` see the state AFTER the
// whole batch commits. We use *After where a rule must accept a document
// that is created/updated in the same batch.

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function familyPath(familyId) {
      return /databases/$(database)/documents/families/$(familyId);
    }

    function userPath(u) {
      return /databases/$(database)/documents/users/$(u);
    }

    // Requester's own profile document (may not exist yet right after sign-up).
    function requesterFamilyId() {
      return get(userPath(uid())).data.get('familyId', null);
    }

    // True when, after the current batch, the caller's profile no longer
    // points at familyId. Leaving a family must clear users/{uid}.familyId in
    // the same batch, otherwise the stale value would keep satisfying the
    // users read rule (familyId == requesterFamilyId) after departure.
    function callerFamilyIdClearedAfter(familyId) {
      return !existsAfter(userPath(uid()))
        || getAfter(userPath(uid())).data.get('familyId', null) != familyId;
    }

    // True when the caller is currently listed in families/{familyId}.members.
    function isFamilyMember(familyId) {
      return exists(familyPath(familyId))
        && uid() in get(familyPath(familyId)).data.members;
    }

    // Same as isFamilyMember but sees the state after the current batch
    // (needed when the family doc is created/updated in the same batch).
    function isFamilyMemberAfter(familyId) {
      return existsAfter(familyPath(familyId))
        && uid() in getAfter(familyPath(familyId)).data.members;
    }

    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 40;
    }

    function validInviteCode(code) {
      return code is string && code.matches('^[A-Z0-9]{6}$');
    }

    // lastLocation: { lat, lng, updatedAt, acc?, battery?, charging?, src? } — nothing else.
    //   acc      horizontal accuracy in whole metres (int, 0–100000)
    //   battery  level in percent (int, 0–100); omitted when unknown
    //   charging bool
    //   src      what triggered the share: 'open' (app open / foreground),
    //            'manual' (Refresh / Check in), 'sos' (Stage 4). Absent = legacy.
    function validLocation(loc) {
      return loc is map
        && loc.keys().hasOnly(['lat', 'lng', 'updatedAt', 'acc', 'battery', 'charging', 'src'])
        && loc.keys().hasAll(['lat', 'lng', 'updatedAt'])
        && loc.lat is number && loc.lat >= -90 && loc.lat <= 90
        && loc.lng is number && loc.lng >= -180 && loc.lng <= 180
        && loc.updatedAt is timestamp
        && (!('acc' in loc) || (loc.acc is int && loc.acc >= 0 && loc.acc <= 100000))
        && (!('battery' in loc) || (loc.battery is int && loc.battery >= 0 && loc.battery <= 100))
        && (!('charging' in loc) || loc.charging is bool)
        && (!('src' in loc) || (loc.src is string && loc.src in ['open', 'manual', 'sos']));
    }

    // Editable fields of families/{familyId}/places/{placeId}.
    //   radius in whole metres (int, 100–500)
    function validPlace(d) {
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 30
        && d.icon in ['home', 'school', 'work', 'pin']
        && d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180
        && d.radius is int && d.radius >= 100 && d.radius <= 500;
    }

    // A lastLocation being written must be stamped with serverTimestamp():
    // the client cannot fake a fresh (or future) check-in, and the
    // onLocationUpdated 10-min debounce compares server times only.
    // Clearing it (null) is allowed.
    function locationStampedNow(d) {
      return !('lastLocation' in d) || d.lastLocation == null
        || d.lastLocation.updatedAt == request.time;
    }

    // Full shape of a users/{uid} document (checked on create AND update —
    // request.resource.data is the merged document after the write).
    // The push token is NOT here: family members can read users docs, so it
    // lives in owner-only pushTokens/{uid}.
    // `pass` (Stage 7) is listed so a client update of another field still
    // validates once the server has written it; clients can never create,
    // change or remove it (see the users create / update rules).
    function validUser(d) {
      return d.keys().hasOnly(['name', 'photoURL', 'familyId', 'lastLocation',
                               'notifyOnCheckIn', 'updatedAt', 'pass'])
        && validName(d.name)
        && (!('photoURL' in d) || d.photoURL == null
            || (d.photoURL is string && d.photoURL.size() <= 2048))
        && (!('familyId' in d) || d.familyId == null || d.familyId is string)
        && (!('lastLocation' in d) || d.lastLocation == null || validLocation(d.lastLocation))
        && d.notifyOnCheckIn is bool
        && d.updatedAt is timestamp;
    }

    // familyId may be absent/null (no family, or leaving) or must point to a
    // family that lists the caller as a member (after the batch commits).
    function familyIdAllowed(d) {
      return !('familyId' in d) || d.familyId == null
        || (d.familyId is string && isFamilyMemberAfter(d.familyId));
    }

    // Stage 7 — Family Pass. users/{uid}.pass = { transactionId, productId,
    // verifiedAt } is written only by the redeemFamilyPass function after it
    // has verified Apple's signed transaction, and removed by
    // appStoreNotifications on refund. Reads `get()` (state before the batch),
    // so the pass must already be on the profile when the create batch runs.
    function hasPass() {
      return get(userPath(uid())).data.get('pass', null) != null;
    }

    // ------------------------------------------------------------------
    // users/{uid}
    // ------------------------------------------------------------------
    match /users/{userId} {
      // Read: yourself, or anyone in the same family.
      // For list queries the client must filter `familyId == <myFamilyId>`
      // so the rule is provable without scanning.
      allow get, list: if signedIn()
        && (uid() == userId
            || (resource.data.get('familyId', null) != null
                && resource.data.familyId == requesterFamilyId()));

      // Create: owner only, valid shape, familyId (if set) must be a family
      // the user belongs to. Never with a pass (server-only).
      allow create: if signedIn()
        && uid() == userId
        && validUser(request.resource.data)
        && !('pass' in request.resource.data)
        && locationStampedNow(request.resource.data)
        && familyIdAllowed(request.resource.data);

      // Update: owner only. familyId is re-validated only when it changes,
      // so plain location / settings updates cost no extra document reads.
      // The lastLocation timestamp check applies only when lastLocation is
      // added / changed / removed, so a name or settings update still passes
      // while the stored lastLocation.updatedAt is old.
      // `pass` may not be added, changed or removed by the client.
      allow update: if signedIn()
        && uid() == userId
        && validUser(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pass'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastLocation'])
            || locationStampedNow(request.resource.data))
        && (request.resource.data.get('familyId', null) == resource.data.get('familyId', null)
            || familyIdAllowed(request.resource.data));

      // Delete: owner only (normally done by the onUserDeleted function).
      allow delete: if signedIn() && uid() == userId;
    }

    // ------------------------------------------------------------------
    // pushTokens/{uid}  ->  { token, updatedAt }   (Stage 4)
    // The FCM token of the owner's phone. Owner only — not even family can
    // read it, so nobody can copy someone else's token. Cloud Functions read
    // it with the Admin SDK to send pushes, delete it when FCM reports it
    // dead or another account saves the same token, and on account deletion.
    // ------------------------------------------------------------------
    match /pushTokens/{userId} {
      allow read: if signedIn() && uid() == userId;

      allow create, update: if signedIn()
        && uid() == userId
        && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
        && request.resource.data.keys().hasAll(['token', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 1
        && request.resource.data.token.size() <= 4096
        && request.resource.data.updatedAt == request.time;

      allow delete: if signedIn() && uid() == userId;
    }

    // ------------------------------------------------------------------
    // families/{familyId}
    // ------------------------------------------------------------------
    match /families/{familyId} {
      // Read: members only. List queries must use
      // `members array-contains <uid>`.
      allow get, list: if signedIn() && uid() in resource.data.members;

      // Create: the creator is the sole member and holds a Family Pass
      // (Stage 7; joining stays free). The matching inviteCodes/{code} doc
      // must be written in the same batch.
      allow create: if signedIn()
        && hasPass()
        && request.resource.data.keys().hasOnly(['name', 'inviteCode', 'members', 'createdBy', 'createdAt'])
        && validName(request.resource.data.name)
        && validInviteCode(request.resource.data.inviteCode)
        && request.resource.data.createdBy == uid()
        && request.resource.data.members == [uid()]
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode))
        && getAfter(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.familyId == familyId;

      // Update — exactly one of:
      //   (a) join:   add ONLY your own uid to members (arrayUnion)
      //   (b) leave:  remove ONLY your own uid from members (arrayRemove);
      //               users/{uid}.familyId must be cleared in the same batch
      //   (c) rename: creator changes `name` only
      allow update: if signedIn() && (
        // (a) join — caller is not a member yet
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && !(uid() in resource.data.members)
          && uid() in request.resource.data.members
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members))
        ||
        // (b) leave — caller is a member
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && uid() in resource.data.members
          && !(uid() in request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && resource.data.members.hasAll(request.resource.data.members)
          && callerFamilyIdClearedAfter(familyId))
        ||
        // (c) rename — creator only
        (resource.data.createdBy == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && validName(request.resource.data.name))
      );

      // Delete: server only. The last member leaving (members -> []) fires
      // onFamilyUpdated, which purges the family, its invite code, places,
      // pings and chat.
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // families/{familyId}/places/{placeId}   (Stage 3.6)
    // Saved places used only to label an already-shared location; nothing
    // is monitored. Any member may read / add / edit / delete. The 10-place
    // cap is client-enforced (rules cannot count documents).
    // ------------------------------------------------------------------
    match /families/{familyId}/places/{placeId} {
      allow get, list: if signedIn() && isFamilyMember(familyId);

      allow create: if signedIn()
        && isFamilyMember(familyId)
        && request.resource.data.keys().hasOnly(['name', 'icon', 'lat', 'lng', 'radius', 'createdBy', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'icon', 'lat', 'lng', 'radius', 'createdBy', 'createdAt'])
        && validPlace(request.resource.data)
        && request.resource.data.createdBy == uid()
        && request.resource.data.createdAt == request.time;

      // Update: createdBy / createdAt are immutable; no new keys.
      allow update: if signedIn()
        && isFamilyMember(familyId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'icon', 'lat', 'lng', 'radius'])
        && validPlace(request.resource.data);

      allow delete: if signedIn() && isFamilyMember(familyId);
    }

    // ------------------------------------------------------------------
    // families/{familyId}/pings/{pingId}   (Stage 10 — "Ask location")
    //   { fromUid, fromName, toUid, createdAt }
    // A member asks another member where they are. onPingCreated pushes the
    // recipient and then deletes the doc, so a ping lives for a few seconds.
    // Create only; never changed or removed by clients.
    // ------------------------------------------------------------------
    match /families/{familyId}/pings/{pingId} {
      allow get, list: if signedIn() && isFamilyMember(familyId);

      allow create: if signedIn()
        && isFamilyMember(familyId)
        && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'toUid', 'createdAt'])
        && request.resource.data.keys().hasAll(['fromUid', 'fromName', 'toUid', 'createdAt'])
        && request.resource.data.fromUid == uid()
        && validName(request.resource.data.fromName)
        && request.resource.data.toUid is string
        && request.resource.data.toUid != uid()
        && request.resource.data.toUid in get(familyPath(familyId)).data.members
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // families/{familyId}/pingState/{fromUid_toUid}  ->  { at }   (Stage 10)
    // onPingCreated's 60 s rate-limit bookkeeping (Admin SDK). No client
    // access at all.
    // ------------------------------------------------------------------
    match /families/{familyId}/pingState/{id} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // inviteCodes/{code}  ->  { familyId }
    // Lookup table so joining never requires listing families.
    // ------------------------------------------------------------------
    match /inviteCodes/{code} {
      // Any signed-in user may GET a single code (that is how you join).
      // Listing is denied so codes cannot be enumerated.
      allow get: if signedIn();
      allow list: if false;

      // Create: only alongside a family the caller created (same batch).
      // A create on an existing doc fails, which enforces uniqueness.
      allow create: if signedIn()
        && validInviteCode(code)
        && request.resource.data.keys().hasOnly(['familyId'])
        && request.resource.data.familyId is string
        && existsAfter(familyPath(request.resource.data.familyId))
        && getAfter(familyPath(request.resource.data.familyId)).data.createdBy == uid()
        && getAfter(familyPath(request.resource.data.familyId)).data.inviteCode == code;

      allow update: if false;

      // Delete: server only (purgeFamily in Cloud Functions).
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // passes/{transactionId}  ->  { uid, productId, redeemedAt }   (Stage 7)
    // One Apple transaction, one account. Written by redeemFamilyPass and
    // deleted by appStoreNotifications (Admin SDK). No client access at all.
    // ------------------------------------------------------------------
    match /passes/{transactionId} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // chats/{familyId}/messages/{messageId}
    // One chat per family. Messages are append-only (no edit / delete)
    // to keep the SOS trail honest and the rules simple.
    // ------------------------------------------------------------------
    match /chats/{familyId}/messages/{messageId} {
      allow get, list: if signedIn() && isFamilyMember(familyId);

      allow create: if signedIn()
        && isFamilyMember(familyId)
        && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'text', 'type', 'createdAt'])
        && request.resource.data.senderId == uid()
        && validName(request.resource.data.senderName)
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000
        && request.resource.data.type in ['normal', 'sos']
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;

      // ----------------------------------------------------------------
      // .../acks/{userId}  ->  { at }   (Stage 9)
      // "I have seen this SOS": sosReminder stops re-alerting a member once
      // their ack exists. Members create only their own, stamped with
      // serverTimestamp(); never changed or removed by clients (the family
      // purge deletes them with the chat). The parent message's type is not
      // checked — an ack on a normal message is harmless.
      // ----------------------------------------------------------------
      match /acks/{userId} {
        allow get, list: if signedIn() && isFamilyMember(familyId);

        allow create: if signedIn()
          && isFamilyMember(familyId)
          && uid() == userId
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time;

        allow update, delete: if false;
      }
    }
  }
}
