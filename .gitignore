# Xcode (FamilyMap.xcodeproj is generated by XcodeGen from project.yml)
xcuserdata/
DerivedData/
build/
*.xcodeproj
*.xcworkspace
!default.xcworkspace
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# SwiftPM
.build/
.swiftpm/

# Apple signing / API keys (live in Codemagic or the owner's keychain, never in git)
*.p8
*.p12
*.cer
*.mobileprovision

# Firebase secrets (CI writes it from the GOOGLE_SERVICE_INFO_PLIST env var)
FamilyMap/Resources/GoogleService-Info.plist
firebase/functions/node_modules/
firebase/functions/lib/
firebase/.firebase/
*-debug.log

# Env
.env
.env.*

# macOS
.DS_Store
